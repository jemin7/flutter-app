# Copy this file to .env and fill in real values. Never commit the real .env.

# MongoDB Atlas connection string (create a free M0 cluster, get this from the Atlas UI).
# Local MongoDB alternative: mongodb://localhost:27017/assignment_db
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/assignment_db?retryWrites=true&w=majority

# Secret used to sign JWTs. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me

# Token lifetime
JWT_EXPIRES_IN=1h

# development | production (production hides internal error details)
NODE_ENV=development

# Port the API listens on (Render injects its own)
PORT=3000
